# LifeOS — copy to .env and fill in. Never commit the filled copy.
# On the server this file is root-owned at /srv/lifeos/.env (OPS-002).

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# Must be the exact external HTTPS origin in production, or SvelteKit CSRF
# rejects form posts. No trailing slash.
ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# The app connects as a scoped role, never as the superuser (OPS-007).
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lifeos_app:@localhost:5432/lifeos

# ─── First-run bootstrap ───────────────────────────────────────────────────
# Optional. If unset, the first run generates a CSPRNG password and prints it
# ONCE to the container log. Either way the credential must be changed at
# first sign-in, which revokes all existing sessions.
LIFEOS_BOOTSTRAP_PASSWORD=

# ─── Storage ───────────────────────────────────────────────────────────────
LIFEOS_UPLOAD_DIR=./var/uploads
LIFEOS_IMPORT_DIR=./var/imports
LIFEOS_BACKUP_DIR=./var/backups

# ─── Locale (DISC-007) ─────────────────────────────────────────────────────
LIFEOS_TIMEZONE=America/Toronto
LIFEOS_CURRENCY=CAD

# ─── Backups (server only) ─────────────────────────────────────────────────
# Restic credentials must also exist OFF the Linode, or a lost host loses the
# ability to read its own backups.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ─── CI/CD — GitHub secrets, not this file ─────────────────────────────────
# LIFEOS_TAILSCALE_IP   the deploy target's 100.x address. Load-bearing:
#                       tailscale-connect logs out before the caller's
#                       hostname lookup would run. See §4 OPS-008.
# SSH_USER / SSH_KEY / SSH_PORT / SSH_KNOWN_HOSTS
# GHCR_USERNAME / GHCR_READ_TOKEN   package:read scope only
# DISCORD_WEBHOOK_ACTIONS
