[Unit]
Description=LifeOS scheduled database backup
Documentation=https://github.com/nuniesmith/lifeos
# The backup talks to the database through docker compose, so docker has to be
# up first. Wants rather than Requires: if docker is genuinely broken the backup
# should fail and be visible in the journal, not be silently cancelled.
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__CHECKOUT__

# Serialised against deploys through the lock deploy.sh already takes. A backup
# is read-only, so an overlap is not corrupting — but a deploy stops the app,
# migrates, and restarts it, and a dump started in the middle of that competes
# for a small host's IO at the exact moment the application needs it. Waiting up
# to 30 minutes is better than racing; if the deploy takes longer than that,
# failing is correct, because the pre-deploy backup has just run anyway.
ExecStart=/usr/bin/flock --wait 1800 __STATE_DIR__/deploy.lock \
    __CHECKOUT__/scripts/backup.sh --scheduled

# This is a Raspberry Pi with 894 MB of RAM. A backup must never be the reason
# the application is slow to answer.
Nice=10
IOSchedulingClass=idle

# pg_dump of a small database is seconds; an hour is the point at which
# something is wrong and should be reported rather than hang forever.
TimeoutStartSec=3600
