[Unit]
Description=Daily LifeOS backup
Documentation=https://github.com/nuniesmith/lifeos

[Timer]
# Early morning, when nobody is using it.
OnCalendar=*-*-* 03:30:00

# Persistent is the setting that matters on a home server. A Pi gets unplugged,
# moved, or left off for a weekend; without this, every backup that fell due
# while it was off is simply skipped, and the gap is invisible. With it, the
# timer fires once shortly after boot to catch up.
Persistent=true

# Nothing else is competing for 03:30 on this host, but a spread keeps the
# backup off the exact minute every log and cron job in the world wakes up.
RandomizedDelaySec=15m

Unit=lifeos-backup.service

[Install]
WantedBy=timers.target
